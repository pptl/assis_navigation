{
  "manifest_version": 3,
  "name": "nav-recorder",
  "version": "0.1.0",
  "description": "Background recorder for the navigation companion: captures API traffic and route changes on whitelisted dev origins and streams them to the local nav-recorder host.",
  "permissions": [
    "nativeMessaging",
    "webNavigation",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "nav-recorder"
  },
  "key": ""
}
